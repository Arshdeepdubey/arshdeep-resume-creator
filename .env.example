# Copy to .env for local runs (.env is git-ignored).
# Option A: local open-source model with Ollama (no account, no cost)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# Option B: GitHub Models (free tier). Use a personal access token with models:read
# LLM_BASE_URL=https://models.github.ai/inference
# LLM_API_KEY=<your github token>
# LLM_MODEL=meta/Llama-3.3-70B-Instruct
